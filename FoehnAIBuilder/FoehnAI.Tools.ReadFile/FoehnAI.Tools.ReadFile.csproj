<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
     <VersionPrefix>1.0.0</VersionPrefix>
     <Description>FoehnAI tool plugin: reads a file's text contents.</Description>
     <Authors>Bryn Lewis</Authors>
     <Title>FoehnAI tool for reading text files</Title>
     <Company>devMobile Software</Company>
     <Product>FoehnAI</Product>
     <Copyright>devmobile Software (c) 2026</Copyright>
     <PackageProjectUrl></PackageProjectUrl>
     <RepositoryUrl>https://github.com/KiwiBryn/FoehnAIBuilder</RepositoryUrl>
     <PackageTags>mistral, mistralAI, AI, Agentic</PackageTags>     
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoehnAI.Tools.Abstractions\FoehnAI.Tool.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="CopyToHostPlugins" AfterTargets="Build">
     <PropertyGroup>
        <HostPluginsDir>$(MSBuildThisFileDirectory)..\FoehnAIBuilder\.plugins\</HostPluginsDir>
     </PropertyGroup>
     <ItemGroup>
        <PluginOutputFiles Include="$(TargetPath)" />
        <PluginOutputFiles Include="$(TargetDir)$(TargetName).pdb"
                           Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
     </ItemGroup>
     <MakeDir Directories="$(HostPluginsDir)" />
     <Copy SourceFiles="@(PluginOutputFiles)"
           DestinationFolder="$(HostPluginsDir)"
           SkipUnchangedFiles="true" />  </Target>

</Project>
