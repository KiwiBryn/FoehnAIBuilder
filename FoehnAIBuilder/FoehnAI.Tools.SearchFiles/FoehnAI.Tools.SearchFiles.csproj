<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>FoehnSharp tool plugin: searches file contents under a directory tree for a text substring.</Description>
    <BaseOutputPath>C:\Users\BrynLewis\source\repos\FoehnAIBuilder\src\FoehnAIBuilder\FoehnAIBuilder\.Plugins</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoehnAI.Tools.Abstractions\FoehnAI.Tool.Abstractions.csproj" />
  </ItemGroup>

  <!--
    Plugins are discovered by FoehnSharpV1 scanning a flat "Plugins" folder for DLLs.
    Copy only this project's own primary output there (never its dependency DLLs -
    FoehnSharp.Abstractions and Logging.Abstractions must stay singly-loaded, resolved
    from the host's own bin directory, so `is ITool` checks succeed across assemblies).
  -->
   <Target Name="CopyToHostPlugins" AfterTargets="Build">
      <PropertyGroup>
         <HostPluginsDir>$(MSBuildThisFileDirectory)..\FoehnAIBuilder\.plugins\</HostPluginsDir>
      </PropertyGroup>
      <ItemGroup>
         <PluginOutputFiles Include="$(TargetPath)" />
         <PluginOutputFiles Include="$(TargetDir)$(TargetName).pdb"
                            Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      </ItemGroup>
      <MakeDir Directories="$(HostPluginsDir)" />
      <Copy SourceFiles="@(PluginOutputFiles)"
            DestinationFolder="$(HostPluginsDir)"
            SkipUnchangedFiles="true" />
   </Target>


</Project>
