<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FoehnSharpV1</RootNamespace>
    <UserSecretsId>2f2f8f8b-2a6a-4a1c-9a8f-6a1b6ec2f7d1</UserSecretsId>
    <VersionPrefix>1.0.0</VersionPrefix>     
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- FoehnBlunt is its own standalone project living under this folder; exclude it so
       its files don't get swept into FoehnSharpV1's own compilation. -->
  <ItemGroup>
    <Compile Remove="FoehnBlunt\**" />
    <Content Remove="FoehnBlunt\**" />
    <EmbeddedResource Remove="FoehnBlunt\**" />
    <None Remove="FoehnBlunt\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FoehnAI.Tools.Abstractions\FoehnAI.Tool.Abstractions.csproj" />
    <ProjectReference Include="..\MistralAI.Client.Mistral\MistralAI.Client.Mistral.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Reflection" />
  </ItemGroup>

</Project>
